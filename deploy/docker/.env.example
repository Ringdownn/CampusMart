# CampusMart 环境配置

# ==================== 基础设施 ====================

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=campusmart
MYSQL_USER=campusmart
MYSQL_PASSWORD=change-me-campusmart-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=campusmart
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# Nacos
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# MinIO
MINIO_ACCESS_KEY=campusmart
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=campusmart

# ==================== JWT 配置 ====================
JWT_SECRET=change-me-at-least-32-bytes-random-secret

# ==================== 服务配置 ====================

# Gateway
GATEWAY_PORT=8080

# Base Service
BASE_SERVICE_PORT=8081

# Message Service
MESSAGE_SERVICE_PORT=8083

# Payment Service
PAYMENT_SERVICE_PORT=8092
ALIPAY_APP_ID=
ALIPAY_NOTIFY_URL=https://your-public-domain.example.com/app/payments/alipay/notify
# 支持 PEM 原文、单行 base64，或把换行写成 \n 的环境变量形式。
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_IS_PRODUCTION=false

# Trade Service
TRADE_SERVICE_PORT=8091
PAY_TIMEOUT_MINUTES=15

# Wallet Service
WALLET_SERVICE_PORT=8093

# Search Engine
SEARCH_ENGINE_PORT=5678

# AI Tagging
AI_TAGGING_PORT=8084

# ==================== 可选：阿里云服务配置 ====================
# search-engine 翻译和 base-service 短信验证码共用这两个 AccessKey。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# base-service 阿里云短信验证码配置。使用默认沙箱/测试模板时可保持默认值。
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_REGION=cn-shanghai
ALIYUN_SMS_SIGN_NAME=速通互联验证码
ALIYUN_SMS_TEMPLATE_CODE=100001
