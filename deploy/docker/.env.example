# CampusMart 环境配置

# ==================== 基础设施 ====================

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=campusmart
MYSQL_USER=campusmart
MYSQL_PASSWORD=change-me-campusmart-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=campusmart
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# Nacos
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP

# MinIO
MINIO_ACCESS_KEY=campusmart
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=campusmart

# ==================== JWT 配置 ====================
JWT_SECRET=change-me-at-least-32-bytes-random-secret

# ==================== 服务配置 ====================

# Gateway
GATEWAY_PORT=8080

# Base Service
BASE_SERVICE_PORT=8081

# Message Service
MESSAGE_SERVICE_PORT=8083

# Search Engine
SEARCH_ENGINE_PORT=5678

# AI Tagging
AI_TAGGING_PORT=8084

# ==================== 可选：阿里云翻译配置 ====================
# search-engine 使用阿里云翻译 SDK 时需要。暂时不用可以留空。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
