# CampusMart 环境配置

# ==================== 基础设施 ====================

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=campusmart

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Nacos
NACOS_NAMESPACE=campusmart

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=campusmart

# ==================== JWT 配置 ====================
JWT_SECRET=your-256-bit-secret-key-here-for-security

# ==================== 服务配置 ====================

# Gateway
GATEWAY_PORT=8080

# Base Service
BASE_SERVICE_PORT=8081

# Message Service
MESSAGE_SERVICE_PORT=8083

# Search Engine
SEARCH_ENGINE_PORT=5678

# AI Tagging
AI_TAGGING_PORT=8084
